module

public import Silmaril.SSA.SeaOfNodes.Diamond.Institution.Defs
public import Silmaril.SSA.SeaOfNodes.Diamond.LambdaSSA.Defs

/-! Equations over the λSSA CFGs generated by the pure scheduled diamond
lowering. Their observations are actual finite λSSA evaluations. -/

@[expose] public section

namespace Silmaril.SSA.SeaOfNodes.Diamond.LambdaSSA.Institution

open CategoryTheory
open RVSDG (Tuple)
open Silmaril.Isotope (Value)
open Silmaril.Isotope.LambdaSSA (Region)
open Silmaril.Isotope.LambdaSSA.Semantics.Region (Eval)

universe u v w
variable {Data : Type u} {P Q : Diamond.Institution.Signature.{u, v} Data}
variable {inputs : List (ValueSort Data)} {out : ValueSort Data}

/-- Relabel the actual λSSA primitive, retaining its ordered operand sorts and result sort. -/
def mapPrimitive (h : P ⟶ Q) : Primitive P.op → Primitive Q.op
  | .apply op => .apply (Diamond.Institution.Signature.Hom.opcode h op)

/-- A λSSA region at the input and result boundary of a generated diamond.
The witness is a proposition. Execution uses only the underlying region. -/
abbrev GeneratedRegion (P : Diamond.Institution.Signature.{u, v} Data)
    (inputs : List (ValueSort Data)) (out : ValueSort Data) :=
  { region : Region (Primitive P.op) //
    ∃ sigs : List (List (Ty Data)), ∃ g : Graph P.op inputs sigs out, lower g = region }

def GeneratedRegion.ofGraph {sigs : List (List (Ty Data))} (g : Graph P.op inputs sigs out) :
    GeneratedRegion P inputs out :=
  ⟨lower g, ⟨sigs, g, rfl⟩⟩

/-- Both regions use the same typed input context and single-exit result type. -/
structure Equation (P : Diamond.Institution.Signature.{u, v} Data) where
  inputs : List (ValueSort Data)
  out : ValueSort Data
  lhs : GeneratedRegion P inputs out
  rhs : GeneratedRegion P inputs out

/-- Compare finite exit-and-payload observations at every encoded typed input.
The pure room has unit ambient state. Its primitive interpretation is the one
used by the verified diamond lowering. -/
def Equation.Holds (e : Equation P) (m : Model.{u, v, w} P.op) : Prop :=
  ∀ (input : Tuple (Val m.value) (dataPorts e.inputs)) (label : Nat) (payload : Value (Atom m)),
    Eval (instruction m) (inputEnv m input) e.lhs.val () label payload () ↔
      Eval (instruction m) (inputEnv m input) e.rhs.val () label payload ()

def lowerEquation (e : Diamond.Institution.Equation P) : Equation P :=
  ⟨e.inputs, e.out, GeneratedRegion.ofGraph e.lhs, GeneratedRegion.ofGraph e.rhs⟩

/-- The room for the generated λSSA profile, with the native total models
interpreted via the existing instruction and input encoding. -/
def room (P : Diamond.Institution.Signature.{u, v} Data) :
    Silmaril.Logic.Institution.Room.{max u v, max u v (w + 1), max u v (w + 1)} where
  Sen := Equation P
  Mod := (Diamond.Institution.room.{u, v, w} P).Mod
  Sat m e := e.Holds m.as

end Silmaril.SSA.SeaOfNodes.Diamond.LambdaSSA.Institution
