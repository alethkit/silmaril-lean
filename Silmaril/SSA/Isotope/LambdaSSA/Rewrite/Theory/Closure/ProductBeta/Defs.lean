module

public import Mathlib.Logic.Relation
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.CfgEta.Defs

/-! # The opt-in constructor-pair equation for λSSA -/

public section

universe u v

namespace Silmaril.Isotope.LambdaSSA.Region.ProductBeta

variable {τ : Type u} [TypeFormers τ] {Φ : Type v} [HasTy Φ τ]

set_option autoImplicit true in
set_option relaxedAutoImplicit true in
/-- The constructor-valued instance of Figure 19's `let₂-pair`, contracted
along the two unary β steps of Figure 18 in arXiv:2411.09347v2. The right
component occupies de Bruijn slot zero and the left occupies slot one. -/
inductive Step : VCtx τ → Region Φ → Region Φ → LCtx τ → Prop where
  | let₂Beta (ha : Tm.BranchValue Γ a A) (hb : Tm.BranchValue Γ b B)
      (hr : Region.HasType (B :: A :: Γ) r L) :
      Step Γ (.let₂ (.pair a b) r)
        (r.substVars (Tm.consSubst b (Tm.singleSubst a))) L

/-- Equivalence on typed regions generated by CFG η and constructor-pair β.
Finite nonempty chains suffice because CFG η supplies typed reflexivity. -/
abbrev Eqv (Γ : VCtx τ) (r s : Region Φ) (L : LCtx τ) : Prop :=
  Relation.TransGen (Relation.SymmGen (fun r s => CfgEta.Eqv Γ r s L ∨ Step Γ r s L)) r s

end Silmaril.Isotope.LambdaSSA.Region.ProductBeta
