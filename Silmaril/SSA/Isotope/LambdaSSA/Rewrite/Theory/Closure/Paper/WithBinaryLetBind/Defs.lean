module

public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.Extension.Defs
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.BinaryLetBind.Defs

/-! # The opt-in Paper presentation with binary-let binding -/

public section

universe u v

namespace Silmaril.Isotope.LambdaSSA.Region.Paper.WithBinaryLetBind

open Silmaril.Isotope.LambdaSSA

variable {τ : Type u} [TypeFormers τ] {Φ : Type v} [HasTy Φ τ]

/-- The contextual extension generated by the standalone Figure 19 step. -/
abbrev Eqv : VCtx τ → Region Φ → Region Φ → LCtx τ → Prop :=
  Extension.Eqv BinaryLetBind.Step

/-- Evaluate the scrutinee once, then destructure its bound value. -/
theorem let₂_bind {Γ : VCtx τ} {L : LCtx τ} {r : Region Φ} {a : Tm Φ} {A B : τ}
    (ha : Tm.HasType Γ a (Silmaril.product A B)) (hr : HasType (B :: A :: Γ) r L) :
    Eqv Γ (.let₂ a r) (BinaryLetBind.rebound a r) L :=
  .extra (.let₂ ha hr) (BinaryLetBind.rebound_typed ha hr) (.bind ha hr)

end Silmaril.Isotope.LambdaSSA.Region.Paper.WithBinaryLetBind
