module

public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.WithProductDestructureReturns.Generation.Defs
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.Paper.WithProductDestructureReturns.Thms
import Silmaril.Proofs.SSA.Isotope.LambdaSSA.Rewrite.Paper.GuardedSingletonGeneration

/-! # The combined generation theorem for guarded singleton representatives -/

public section

namespace Silmaril.Isotope.LambdaSSA.Region.Paper.WithProductDestructureReturns

open Silmaril Silmaril.Isotope.LambdaSSA
open Paper.Extension.Singleton (ofRegion)
open Paper.SingletonReification.BinaryLet (applyPackedPair_typed returnPair)
open Paper.RetainedLet (returnOnce)
open Paper.WithPairReturns (ReturnFragmentWithRules)
open Paper.Extension.Singleton.Generation (Generated)

universe u v w

variable {τ : Type u} [TypeFormers τ] {Φ : Type v} [HasTy Φ τ]
  {ε : Type w} [HasEff Φ ε] (pe : ε)

/-- The actual guarded singleton representative is generated by induction on
its syntax certificate. The returned-term case uses the checked term induction. -/
theorem generated_guardedFragment {X D : τ} {r : Region Φ} {hr : ValueBranches [X] r [D]}
    (h : GuardedFragment pe hr) : Generated (JoinedStep pe) (ofRegion (JoinedStep pe) hr) :=
  Silmaril.Proofs.SSA.Isotope.LambdaSSA.Rewrite.Paper.GuardedSingletonGeneration.generated_guardedFragment pe h

/-- A computed product can use the same native binary-let factorization once
its destructure-and-rebuild producer agrees with the once-only return. -/
theorem generated_let₂_of_returnPair_eq_returnOnce {X A B D : τ} {a : Tm Φ} {p : Region Φ}
    {ha : Tm.HasType [X] a (product A B)} {hp : ValueBranches [product X (product A B)] p [D]}
    (producer : ReturnFragmentWithRules pe true true ha)
    (eq : Paper.Extension.Eqv (JoinedStep pe) [X] (returnPair a) (returnOnce a) [product A B])
    (body : Generated (JoinedStep pe) (ofRegion (JoinedStep pe) hp)) :
    Generated (JoinedStep pe) (ofRegion (JoinedStep pe) (.let₂ ha (applyPackedPair_typed hp))) :=
  Silmaril.Proofs.SSA.Isotope.LambdaSSA.Rewrite.Paper.GuardedSingletonGeneration.generated_let₂_of_returnPair_eq_returnOnce
    pe producer eq body

end Silmaril.Isotope.LambdaSSA.Region.Paper.WithProductDestructureReturns
