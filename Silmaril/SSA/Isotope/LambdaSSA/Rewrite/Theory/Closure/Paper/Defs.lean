module

public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.CfgEta.Codiagonal.Defs
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.CfgEta.Uniformity.Defs
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.Closure.ProductBeta.Defs
public import Silmaril.SSA.Isotope.LambdaSSA.Rewrite.Theory.ProductEta.Step.Defs

/-! # Opt-in typed closure of λSSA equations

This presentation combines the standalone product equations with CFG η,
duplicate-feedback collapse and pure feedback simulation.
-/

public section

universe u v

namespace Silmaril.Isotope.LambdaSSA.Region.Paper

open CfgEta (singleCfg)

variable {τ : Type u} [TypeFormers τ] {Φ : Type v} [HasTy Φ τ]

set_option autoImplicit true in
set_option relaxedAutoImplicit true in
/-- Exact typed equivalence generated by the selected paper equations and
their typed contexts. Literal substitution into a producer requires
constructor-valued branch arguments. -/
inductive Eqv : VCtx τ → Region Φ → Region Φ → LCtx τ → Prop where
  | cfgEta : CfgEta.Eqv Γ r s L → Eqv Γ r s L
  | productBeta : ProductBeta.Step Γ r s L → Eqv Γ r s L
  | productEta : ProductEta.Step Γ r s L → Eqv Γ r s L
  | symm : Eqv Γ r s L → Eqv Γ s r L
  | trans : Eqv Γ r s L → Eqv Γ s t L → Eqv Γ r t L
  | let₁ (ha : Tm.HasType Γ a A) (hr : Eqv (A :: Γ) r s L) :
      Eqv Γ (.let₁ a r) (.let₁ a s) L
  | let₂ (ha : Tm.HasType Γ a (Silmaril.product A B)) (hr : Eqv (B :: A :: Γ) r s L) :
      Eqv Γ (.let₂ a r) (.let₂ a s) L
  | case (ha : Tm.HasType Γ a (Silmaril.coprod A B))
      (hl : Eqv (A :: Γ) l l' L) (hr : Eqv (B :: Γ) r r' L) :
      Eqv Γ (.case a l r) (.case a l' r') L
  | cfg (R : Fin n → τ) (he : Eqv Γ entry entry' (List.ofFn R ++ L))
      (hb : ∀ i, Eqv (R i :: Γ) (bs i) (bs' i) (List.ofFn R ++ L)) :
      Eqv Γ (.cfg entry n bs) (.cfg entry' n bs') L
  | lsubstCongr (hp : ValueBranches Γ p L)
      (h : ∀ ⦃i A⦄, At L i A → Eqv (A :: Γ) (σ i) (υ i) K) :
      Eqv Γ (p.lsubst σ) (p.lsubst υ) K
  | lsubstPost (h : Eqv Γ r s L) (hr : ValueBranches Γ r L) (hs : ValueBranches Γ s L)
      (hσ : LSubst.HasType Γ L K σ) :
      Eqv Γ (r.lsubst σ) (s.lsubst σ) K
  | substVars (h : Eqv Γ r s L)
      (hθ : ∀ ⦃i A⦄, At Γ i A → Tm.BranchValue Δ (θ i) A) :
      Eqv Δ (r.substVars θ) (s.substVars θ) L
  | renameLabels (h : Eqv Γ r s L) (hρ : Ren L K ρ) :
      Eqv Γ (r.renameLabels ρ) (s.renameLabels ρ) K
  | collapsePost (he : ValueBranches Γ e (A :: L))
      (hp : ValueBranches (A :: Γ) p (A :: A :: L)) (hσ : LSubst.HasType Γ L K σ) :
      Eqv Γ ((CfgEta.Codiagonal.nested e p).lsubst σ)
        ((CfgEta.Codiagonal.flattened e p).lsubst σ) K
  | uniform (he : ValueBranches Γ entry (A :: L))
      (hp : ValueBranches (A :: Γ) p (A :: L)) (hq : HasType (D :: Γ) q (D :: L))
      (ha : Tm.BranchValue (A :: Γ) a D)
      (square : Eqv (A :: Γ)
        (p.lsubst (liftLSubstVars (CfgEta.Uniformity.localMap a)))
        ((Region.br 0 a).lsubst (liftLSubstVars (fun _ => q))) (D :: L)) :
      Eqv Γ (singleCfg entry p)
        (singleCfg (entry.lsubst (CfgEta.Uniformity.localMap a)) q) L

/-- Pointwise equivalence of typed continuations at the same interface. -/
@[expose] def Equivalent (Γ : VCtx τ) (L K : LCtx τ) (σ υ : Nat → Region Φ) : Prop :=
  ∀ ⦃i A⦄, At L i A → Eqv (A :: Γ) (σ i) (υ i) K

end Silmaril.Isotope.LambdaSSA.Region.Paper
