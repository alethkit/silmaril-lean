module

public import Silmaril.SSA.Isotope.LetIter.PaperExpression.Substitution.Defs

/-! # The discrete SSA expression equations at a fixed effect bound

The generators are the discrete-type instances of `Rewrite`, `Reduce`
and `Term.TStep` in `imbrem/debruijn-ssa` at
`316bd9a6511d165b5d1d0042956a72e0f5547091`. The congruence constructors
combine the one-hole rules of that presentation.
-/

@[expose] public section

universe u v w

namespace Silmaril.Isotope.LetIter.PaperExpression.Source

variable {τ : Type u} {Φ : Type v} {ε : Type w}

inductive Rewrite : Expr Φ → Expr Φ → Prop where
  | let1_op (f a b) : Rewrite (.let₁ (.op f a) b) (.let₁ a (.let₁ (.op f (.var 0)) b.wk1))
  | let1_let1 (a b c) : Rewrite (.let₁ (.let₁ a b) c) (.let₁ a (.let₁ b c.wk1))
  | let1_let2 (a b c) : Rewrite (.let₁ (.let₂ a b) c) (.let₂ a (.let₁ b c.wk1.wk1))
  | let1_case (a l r b) :
      Rewrite (.let₁ (.case a l r) b) (.case a (.let₁ l b.wk1) (.let₁ r b.wk1))
  | let1_abort (a b) :
      Rewrite (.let₁ (.abort a) b) (.let₁ a (.let₁ (.abort (.var 0)) b.wk1))
  | let2_eta (a) : Rewrite (.let₂ a (.pair (.var 1) (.var 0))) a
  | let2_pair (a b c) : Rewrite (.let₂ (.pair a b) c) (.let₁ a (.let₁ b.wk0 c))
  | let1_eta (a) : Rewrite (.let₁ a (.var 0)) a
  | let2_bind (a b) : Rewrite (.let₂ a b) (.let₁ a (.let₂ (.var 0) b.wk2))
  | case_bind (a l r) : Rewrite (.case a l r) (.let₁ a (.case (.var 0) l.wk1 r.wk1))
  | case_eta (a) : Rewrite (.case a (.inl (.var 0)) (.inr (.var 0))) a

inductive Reduce : Expr Φ → Expr Φ → Prop where
  | case_inl (a l r) : Reduce (.case (.inl a) l r) (.let₁ a l)
  | case_inr (a l r) : Reduce (.case (.inr a) l r) (.let₁ a r)

variable [TypeFormers τ]

/-- Structurally initial types in the source grammar. -/
inductive InitialType : τ → Prop where
  | empty : InitialType empty
  | product_left {A B} : InitialType A → InitialType (product A B)
  | product_right {A B} : InitialType B → InitialType (product A B)
  | coprod {A B} : InitialType A → InitialType B → InitialType (coprod A B)

variable [HasTy Φ τ] [HasEff Φ ε] [Preorder ε] [Bot ε]

/-- A bottom-annotated slot with a structurally initial type. -/
def InitialContext (Γ : EffectCtx τ ε) : Prop :=
  ∃ i : Fin Γ.length, InitialType (Γ.get i).1 ∧ (Γ.get i).2 = ⊥

/-- The source generating steps, with typing at the common effect bound. -/
inductive Step : EffectCtx τ ε → τ → ε → Expr Φ → Expr Φ → Prop where
  | let1_beta {Γ A B e a b} : Wf Γ a A ⊥ → Wf ((A, ⊥) :: Γ) b B e →
      Step Γ B e (.let₁ a b) (b.subst a.subst0)
  | rewrite {Γ A e a b} : Wf Γ a A e → Wf Γ b A e → Rewrite a b → Step Γ A e a b
  | reduce {Γ A e a b} : Wf Γ a A e → Wf Γ b A e → Reduce a b → Step Γ A e a b
  | initial {Γ A e a b} : InitialContext Γ → Wf Γ a A e → Wf Γ b A e → Step Γ A e a b
  | terminal {Γ e a b} : Wf Γ a unit ⊥ → Wf Γ b unit ⊥ → Step Γ unit e a b

/-- Typed equivalence and constructor congruence generated by the source steps. -/
inductive Eqv : EffectCtx τ ε → τ → ε → Expr Φ → Expr Φ → Prop where
  | step {Γ A e a b} : Step Γ A e a b → Eqv Γ A e a b
  | refl {Γ A e a} : Wf Γ a A e → Eqv Γ A e a a
  | symm {Γ A e a b} : Eqv Γ A e a b → Eqv Γ A e b a
  | trans {Γ A e a b c} : Eqv Γ A e a b → Eqv Γ A e b c → Eqv Γ A e a c
  | op {Γ e f a b} : instrEff f ≤ e → Eqv Γ (instrSrc f) e a b →
      Eqv Γ (instrTrg f) e (.op f a) (.op f b)
  | let1 {Γ A B e a a' b b'} : Eqv Γ A e a a' → Eqv ((A, ⊥) :: Γ) B e b b' →
      Eqv Γ B e (.let₁ a b) (.let₁ a' b')
  | pair {Γ A B e a a' b b'} : Eqv Γ A e a a' → Eqv Γ B e b b' →
      Eqv Γ (product A B) e (.pair a b) (.pair a' b')
  | let2 {Γ A B C e a a' b b'} : Eqv Γ (product A B) e a a' →
      Eqv ((B, ⊥) :: (A, ⊥) :: Γ) C e b b' → Eqv Γ C e (.let₂ a b) (.let₂ a' b')
  | inl {Γ A B e a a'} : Eqv Γ A e a a' → Eqv Γ (coprod A B) e (.inl a) (.inl a')
  | inr {Γ A B e b b'} : Eqv Γ B e b b' → Eqv Γ (coprod A B) e (.inr b) (.inr b')
  | case {Γ A B C e a a' l l' r r'} : Eqv Γ (coprod A B) e a a' →
      Eqv ((A, ⊥) :: Γ) C e l l' → Eqv ((B, ⊥) :: Γ) C e r r' →
      Eqv Γ C e (.case a l r) (.case a' l' r')
  | abort {Γ A e a a'} : Eqv Γ empty e a a' → Eqv Γ A e (.abort a) (.abort a')

abbrev TypedExpr (Φ : Type v) [HasTy Φ τ] [HasEff Φ ε]
    (Γ : EffectCtx τ ε) (A : τ) (e : ε) := { a : Expr Φ // Wf Γ a A e }

instance typedExprSetoid (Γ : EffectCtx τ ε) (A : τ) (e : ε) :
    Setoid (TypedExpr Φ Γ A e) where
  r a b := Eqv Γ A e a.val b.val
  iseqv := ⟨fun a => .refl a.prop, Eqv.symm, Eqv.trans⟩

/-- Source classes retain both the result type and the effect bound. -/
abbrev Class (Φ : Type v) [HasTy Φ τ] [HasEff Φ ε]
    (Γ : EffectCtx τ ε) (A : τ) (e : ε) :=
  Quotient (typedExprSetoid (Φ := Φ) Γ A e)

abbrev Hom (Φ : Type v) [HasTy Φ τ] [HasEff Φ ε]
    (X A : τ) (e : ε) := Class Φ [(X, ⊥)] A e

/-- The paper's left-associated product of slots, starting at the unit. -/
def packType : EffectCtx τ ε → τ
  | [] => unit
  | (A, _) :: Γ => product (packType Γ) A

def first (a : Expr Φ) : Expr Φ := .let₂ a (.var 1)
def second (a : Expr Φ) : Expr Φ := .let₂ a (.var 0)

/-- Project a newest-first slot out of a packed product. -/
def project : Nat → Expr Φ → Expr Φ
  | 0, a => second a
  | i + 1, a => project i (first a)

/-- Build a left-associated tuple of the given slots. -/
def tuple : Nat → (Nat → Expr Φ) → Expr Φ
  | 0, _ => .unit
  | n + 1, σ => .pair (tuple n (σ ∘ Nat.succ)) (σ 0)

/-- Pack an expression by replacing each ambient variable with a projection. -/
def packExpr (a : Expr Φ) : Expr Φ :=
  a.subst (fun i => project i (.var 0))

/-- Reopen a singleton-context expression with the tuple of original variables. -/
def unpackExpr (Γ : EffectCtx τ ε) (a : Expr Φ) : Expr Φ :=
  a.subst (tuple Γ.length Expr.var).subst0

/-- Interpret expression constructors on a singleton environment. The binding
clauses evaluate the scrutinee and then form the extended environment from
the retained input and the new values. -/
def denoteExpr : Expr Φ → Expr Φ
  | .var i => project i (.var 0)
  | .op f a => .op f (denoteExpr a)
  | .let₁ a b =>
      .let₁ (denoteExpr a) ((denoteExpr b).subst (Expr.pair (.var 1) (.var 0)).subst0)
  | .pair a b => .pair (denoteExpr a) (denoteExpr b)
  | .unit => .unit
  | .let₂ a b =>
      .let₂ (denoteExpr a)
        ((denoteExpr b).subst (Expr.pair (.pair (.var 2) (.var 1)) (.var 0)).subst0)
  | .inl a => .inl (denoteExpr a)
  | .inr a => .inr (denoteExpr a)
  | .case a l r =>
      .case (denoteExpr a) ((denoteExpr l).subst (Expr.pair (.var 1) (.var 0)).subst0)
        ((denoteExpr r).subst (Expr.pair (.var 1) (.var 0)).subst0)
  | .abort a => .abort (denoteExpr a)

end Silmaril.Isotope.LetIter.PaperExpression.Source
