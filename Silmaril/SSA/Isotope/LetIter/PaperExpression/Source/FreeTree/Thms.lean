module

public import Silmaril.SSA.Isotope.LetIter.PaperExpression.Source.FreeTree.Defs
import Silmaril.Proofs.SSA.Isotope.LetIter.PaperExpression.Source.FreeTree

/-! # Separation for pure free trees in native LetIter -/

public section

open Silmaril Silmaril.Isotope Silmaril.Isotope.Semantics Silmaril.Elgot
open Silmaril.Isotope.LetIter.LocallyNameless
open Silmaril.Isotope.LetIter.PaperExpression
open Silmaril.Isotope.LetIter.PaperExpression.Source

namespace Silmaril.Isotope.LetIter.PaperExpression.Source.FreeTree

universe u r

variable {α : Type u} {Φ : Type u} (S : Signature α Φ)

variable {n : Nat} {sorts : Fin n → α}

/-- The sorted tree algebra is freely generated by the indexed variables. -/
theorem tree_free (F : α → Type (u + 1))
    (ops : (f : Φ) → ((i : Fin (S.arity f)) → F (S.arg f i)) → F (S.out f))
    (vars : (i : Fin n) → F (sorts i)) :
    ∃! g : (a : α) → Tree S sorts a → F a,
      (∀ i, g (sorts i) (.var i) = vars i) ∧
      ∀ f (xs : (i : Fin (S.arity f)) → Tree S sorts (S.arg f i)),
        g (S.out f) (.op f xs) = ops f (fun i => g (S.arg f i) (xs i)) :=
  Proofs.tree_free S F ops vars

/-- Lowering the source representation of a free tree gives its native term. -/
theorem tree_lowers {a : α} (t : Tree S sorts a) :
    t.source.toLetIter n = some t.native :=
  Proofs.tree_lowers S t

section Typed

variable {ε : Type r} [HasEff Φ ε] [SemilatticeSup ε] [OrderBot ε]
variable {Γ : EffectCtx (Ty α) ε} {sorts : Fin Γ.length → α}

local notation "Γ₀" => (Ctx.nil : Ctx Empty (Ty α))
local notation "β" => Γ.toBoundCtx

/-- The event model interprets all bottom-effect symbols as total maps. -/
theorem instructions_pure (observe : ObserveInput (sorts := sorts) S) :
    letI := S.endpoints
    InstructionModel.RespectsPure (ε := ε) (instructions (ε := ε) S observe) :=
  Proofs.instructions_pure S observe

variable [DecidableEq α] [EffectIteration ε]

/-- Arbitrarily many sorts and finitary bottom-effect symbols are allowed.
The original bound is kept in the source equation, while the native purity
parameter is bottom. The native proof may use all well-typed intermediates. -/
theorem endpoint_conservativity {a : α} (t s : Tree S sorts a)
    (ht : DeclaredPure (ε := ε) S t) (hs : DeclaredPure (ε := ε) S s)
    (hΓ : Γ.Pure) (hslots : ∀ i, (Γ.get i).1 = .base (sorts i)) (e : ε) :
    letI := S.endpoints
    (AbortEquiv (⊥ : ε) Γ₀ β t.native s.native (.base a) ↔
      Eqv Γ (.base a) e t.source s.source) :=
  Proofs.endpoint_conservativity S t s ht hs hΓ hslots e

/-- For these pure source endpoints the original-bound Eqv identifies
exactly the identical free trees. -/
theorem source_eqv_iff {a : α} (t s : Tree S sorts a)
    (ht : DeclaredPure (ε := ε) S t) (hs : DeclaredPure (ε := ε) S s)
    (hΓ : Γ.Pure) (hslots : ∀ i, (Γ.get i).1 = .base (sorts i)) (e : ε) :
    letI := S.endpoints
    (Eqv Γ (.base a) e t.source s.source ↔ t = s) :=
  Proofs.source_eqv_iff S t s ht hs hΓ hslots e

/-- Inequality holds in the full fixed-bound source relation, for calls
which are well typed at that bound. -/
theorem effectful_call_source_inequality {f : Φ}
    (xs ys : (i : Fin (S.arity f)) → Tree S sorts (S.arg f i))
    (hx : ∀ i, DeclaredPure (ε := ε) S (xs i)) (hy : ∀ i, DeclaredPure (ε := ε) S (ys i))
    (hf : ¬ IsPure (⊥ : ε) f) (hne : xs ≠ ys)
    (hΓ : Γ.Pure) (hslots : ∀ i, (Γ.get i).1 = .base (sorts i)) {e : ε}
    (hle : instrEff f ≤ e) :
    letI := S.endpoints
    let x := Tree.op f xs
    let y := Tree.op f ys
    Wf Γ x.source (.base (S.out f)) e ∧ Wf Γ y.source (.base (S.out f)) e ∧
      ¬ Eqv Γ (.base (S.out f)) e x.source y.source :=
  Proofs.effectful_call_source_inequality S xs ys hx hy hf hne hΓ hslots hle

end Typed

end Silmaril.Isotope.LetIter.PaperExpression.Source.FreeTree
