module

public import Silmaril.SSA.Isotope.Institution.UndefinedBehaviour.Specification.Thms
public import Silmaril.SSA.Isotope.Institution.UndefinedBehaviour.Primitive.Thms

/-! # Explicit UB and the LetIter primitive dialect extension -/

@[expose] public section
noncomputable section

namespace Silmaril.Isotope.Institution.Refinement.UB.LetIter

open CategoryTheory
open Silmaril.Logic.Metatheory.TheoryModel
open Silmaril.Isotope.LetIter.LocallyNameless
open Silmaril.Isotope.Theory (TypingIndex)

universe u

variable {ν τ ε : Type u} [TypeFormers τ] [DecidableEq ν]

attribute [local instance] dialectTyping

variable (P : InstrSig τ ε) (e : ε) (Γ : Ctx ν τ)

/-- Exact terms in the ordinary LetIter dialect with the additional instructions. -/
abbrev Native (i : TypingIndex τ) := Models.Carrier (dialect P e).Instr Γ i

/-- Exact terms with an explicit nullary UB constructor and all native LetIter operations. -/
abbrev Explicit (i : TypingIndex τ) := Expr (iterPSig P.Instr Γ).sig i

/-- The native encoding of UB at an arbitrary typing sort. -/
def nativeUB (i : TypingIndex τ) : Native P e Γ i :=
  ⟨.op (.inr i.result) .unit, .op .unit⟩

/-- The original LetIter operations on native terms, by instruction relabelling. -/
abbrev oldOps : Algebra (iterPSig P.Instr Γ).sig :=
  Algebra.reductObj (Institution.LetIter.sigHom Γ (includeDialect P e))
    (iterPSig (dialect P e).Instr Γ).syn

/-- Native terms interpret the new nullary symbol as the canonical spelling. -/
def nativeAlgebra : Algebra (signature (iterPSig P.Instr Γ).sig) where
  Carrier := Native P e Γ
  op := fun {i} o => match o with
    | none => fun _ => nativeUB P e Γ i
    | some o => (oldOps P e Γ).op o

/-- Type-preserving elaboration into the native extended dialect. -/
def encode {i : TypingIndex τ} (t : Explicit P Γ i) : Native P e Γ i :=
  fold (nativeAlgebra P e Γ) t

/-- Canonical native terms are generated by the old constructors and by literal
unit-fed invocations of the new primitive. -/
inductive Canonical : {i : TypingIndex τ} → Native P e Γ i → Prop
  | ub (i : TypingIndex τ) : Canonical (nativeUB P e Γ i)
  | op {i : TypingIndex τ} (o : (iterPSig P.Instr Γ).sig.Op i)
      (a : (j : Fin ((iterPSig P.Instr Γ).sig.arity o)) →
        Native P e Γ ((iterPSig P.Instr Γ).sig.argSort o j))
      (h : ∀ j, Canonical (a j)) : Canonical ((oldOps P e Γ).op o a)

/-- Read native operations back as the original LetIter constructors; the fresh
unit-taking instruction is read as explicit UB. The inverse theorem restricts
this reading to canonical terms, where the operand is literal unit. -/
def decodeAlgebra : Algebra (iterPSig (dialect P e).Instr Γ).sig where
  Carrier := Explicit P Γ
  op := fun {_} o => match o with
    | .fv (β := β) h => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.fv (β := β) h)
    | .bv (β := β) i => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.bv (β := β) i)
    | .op (β := β) (.inl f) => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.op (β := β) f)
    | .op (.inr _) => fun _ => .ub
    | .let₁ (β := β) A B => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.let₁ (β := β) A B)
    | .unit (β := β) => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.unit (β := β))
    | .pair (β := β) A B => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.pair (β := β) A B)
    | .let₂ (β := β) A B C => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.let₂ (β := β) A B C)
    | .inl (β := β) A B => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.inl (β := β) A B)
    | .inr (β := β) A B => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.inr (β := β) A B)
    | .case (β := β) A B C => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.case (β := β) A B C)
    | .abort (β := β) C => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.abort (β := β) C)
    | .iter (β := β) A B => Expr.node (S := Models.signature P.Instr Γ) (Models.Operation.iter (β := β) A B)

/-- Read back a native term generated using the canonical UB spelling. -/
def decode {i : TypingIndex τ} (t : {t : Native P e Γ i // Canonical P e Γ t}) :
    Explicit P Γ i :=
  (Models.fold (decodeAlgebra P e Γ)).map t.val

end Silmaril.Isotope.Institution.Refinement.UB.LetIter
