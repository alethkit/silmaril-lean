module

public import Silmaril.Semantics.RuntimeWires.Polygraph.Defs

@[expose] public section

/-!
# Runtime monoidal presentation

The generators and relations in Definition 3.8 of Román and Sobociński's
*String Diagrams for Premonoidal Categories*. The runtime is a fresh wire
sort. Only pure generators have boundaries without it.
-/

namespace Silmaril.RuntimeWires

universe u v

/-- Terms of a strict monoidal presentation, before imposing its equations. -/
inductive Diagram {O : Type u} (S : Signature.{u,v} O) : List O → List O → Type (max u v)
  | id (A : List O) : Diagram S A A
  | gen (e : S.Edge) : Diagram S (S.source e) (S.target e)
  | comp {A B C : List O} : Diagram S A B → Diagram S B C → Diagram S A C
  | tensor {A B C D : List O} :
      Diagram S A B → Diagram S C D → Diagram S (A ++ C) (B ++ D)

namespace Diagram

variable {O : Type u} {S : Signature.{u,v} O}

/-- Change boundaries along equalities of words, as required by strict tensor laws. -/
def reindex {A B C D : List O} (hA : A = C) (hB : B = D)
    (f : Diagram S A B) : Diagram S C D :=
  hA ▸ hB ▸ f

/-- Equations with matching boundaries in a monoidal presentation. -/
abbrev Equations (S : Signature.{u,v} O) :=
  ∀ {A B : List O}, Diagram S A B → Diagram S A B → Prop

/-- The strict monoidal congruence generated by additional equations `E`. -/
inductive Congruence (E : Equations S) : Equations S
  | equation {A B : List O} {f g : Diagram S A B} : E f g → Congruence E f g
  | refl {A B : List O} (f : Diagram S A B) : Congruence E f f
  | symm {A B : List O} {f g : Diagram S A B} : Congruence E f g → Congruence E g f
  | trans {A B : List O} {f g h : Diagram S A B} :
      Congruence E f g → Congruence E g h → Congruence E f h
  | comp {A B C : List O} {f f' : Diagram S A B} {g g' : Diagram S B C} :
      Congruence E f f' → Congruence E g g' → Congruence E (.comp f g) (.comp f' g')
  | tensor {A B C D : List O} {f f' : Diagram S A B} {g g' : Diagram S C D} :
      Congruence E f f' → Congruence E g g' → Congruence E (.tensor f g) (.tensor f' g')
  | id_comp {A B : List O} (f : Diagram S A B) : Congruence E (.comp (.id A) f) f
  | comp_id {A B : List O} (f : Diagram S A B) : Congruence E (.comp f (.id B)) f
  | comp_assoc {A B C D : List O} (f : Diagram S A B) (g : Diagram S B C)
      (h : Diagram S C D) : Congruence E (.comp (.comp f g) h) (.comp f (.comp g h))
  | tensor_id (A B : List O) : Congruence E (.tensor (.id A) (.id B)) (.id (A ++ B))
  | tensor_comp {A B C D F G : List O} (f : Diagram S A B) (g : Diagram S B C)
      (h : Diagram S D F) (k : Diagram S F G) :
      Congruence E (.tensor (.comp f g) (.comp h k)) (.comp (.tensor f h) (.tensor g k))
  | tensor_unit_left {A B : List O} (f : Diagram S A B) :
      Congruence E (reindex (List.nil_append A) (List.nil_append B) (.tensor (.id []) f)) f
  | tensor_unit_right {A B : List O} (f : Diagram S A B) :
      Congruence E (reindex (List.append_nil A) (List.append_nil B) (.tensor f (.id []))) f
  | tensor_assoc {A B C D F G : List O} (f : Diagram S A B) (g : Diagram S C D)
      (h : Diagram S F G) :
      Congruence E
        (reindex (List.append_assoc A C F) (List.append_assoc B D G) (.tensor (.tensor f g) h))
        (.tensor f (.tensor g h))

/-- Morphisms presented by generators and equations, at fixed boundaries. -/
def Hom (S : Signature.{u,v} O) (E : Equations S) (A B : List O) :=
  Quotient (α := Diagram S A B)
    ⟨Congruence E, Congruence.refl, Congruence.symm, Congruence.trans⟩

end Diagram

namespace Presentation

/-- Add a fresh runtime sort, represented by `none`. -/
abbrev Wire (O : Type u) := Option O

/-- A boundary of value wires. -/
abbrev values {O : Type u} (A : List O) : List (Wire O) := A.map some

/-- The generators of `Run(V,G)` in Definition 3.8. -/
inductive Edge (G : EffectfulPolygraph.{u,v}) : Type (max u v)
  | pure : G.pure.Edge → Edge G
  | effect : G.effect.Edge → Edge G
  | moveRight : G.Obj → Edge G
  | moveLeft : G.Obj → Edge G

/-- Pure generators ignore the runtime. Effectful generators consume and return it.
The two braidings move it past a single value wire in either direction. -/
abbrev signature (G : EffectfulPolygraph.{u,v}) : Signature.{u, max u v} (Wire G.Obj) where
  Edge := Edge G
  source
    | .pure e => values (G.pure.source e)
    | .effect e => none :: values (G.effect.source e)
    | .moveRight x => [none, some x]
    | .moveLeft x => [some x, none]
  target
    | .pure e => values (G.pure.target e)
    | .effect e => none :: values (G.effect.target e)
    | .moveRight x => [some x, none]
    | .moveLeft x => [none, some x]

variable {G : EffectfulPolygraph.{u,v}}

/-- The elementary crossing from left to right. -/
def crossRight (x : G.Obj) : Diagram (signature G) [none, some x] [some x, none] :=
  Diagram.gen (S := signature G) (Edge.moveRight x)

/-- The elementary crossing from right to left. -/
def crossLeft (x : G.Obj) : Diagram (signature G) [some x, none] [none, some x] :=
  Diagram.gen (S := signature G) (Edge.moveLeft x)

/-- Regard a pure generator as a diagram on value wires. -/
def pureDiagram (e : G.pure.Edge) :
    Diagram (signature G) (values (G.pure.source e)) (values (G.pure.target e)) :=
  Diagram.gen (S := signature G) (Edge.pure e)

/-- Move the runtime from the left of a word to its right. -/
def slideRight : (A : List G.Obj) → Diagram (signature G) (none :: values A) (values A ++ [none])
  | [] => .id [none]
  | x :: A =>
      .comp (.tensor (crossRight (G := G) x) (.id (values A)))
        (Diagram.tensor (A := [some x]) (B := [some x]) (.id _) (slideRight A))

/-- Move the runtime from the right of a word to its left. -/
def slideLeft : (A : List G.Obj) → Diagram (signature G) (values A ++ [none]) (none :: values A)
  | [] => .id [none]
  | x :: A =>
      .comp (Diagram.tensor (A := [some x]) (B := [some x]) (.id _) (slideLeft A))
        (.tensor (crossLeft (G := G) x) (.id (values A)))

/-- Figure 9 imposes inverse crossings and naturality past pure generators.
Crossing a word is defined by crossing its wires in order. -/
inductive Relations (G : EffectfulPolygraph.{u,v}) : Diagram.Equations (signature G)
  | cancelRight (x : G.Obj) :
      Relations G (.comp (crossRight (G := G) x) (crossLeft (G := G) x)) (.id [none, some x])
  | cancelLeft (x : G.Obj) :
      Relations G (.comp (crossLeft (G := G) x) (crossRight (G := G) x)) (.id [some x, none])
  | pureRight (e : G.pure.Edge) :
      Relations G
        (.comp (slideRight (G.pure.source e)) (.tensor (pureDiagram (G := G) e) (.id [none])))
        (.comp (.tensor (.id [none]) (pureDiagram (G := G) e)) (slideRight (G.pure.target e)))
  | pureLeft (e : G.pure.Edge) :
      Relations G
        (.comp (slideLeft (G.pure.source e)) (.tensor (.id [none]) (pureDiagram (G := G) e)))
        (.comp (.tensor (pureDiagram (G := G) e) (.id [none])) (slideLeft (G.pure.target e)))

/-- Presented runtime morphisms of Definition 3.8 at fixed boundaries. -/
abbrev Hom (G : EffectfulPolygraph.{u,v}) (A B : List (Wire G.Obj)) :=
  Diagram.Hom (signature G) (Relations G) A B

/-- Number of runtime wires on a boundary. -/
def runtimeCount {O : Type u} (A : List (Wire O)) : Nat := (A.filter Option.isNone).length

end Presentation

end Silmaril.RuntimeWires
