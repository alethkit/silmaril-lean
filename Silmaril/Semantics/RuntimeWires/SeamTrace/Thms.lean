module

public import Silmaril.Semantics.RuntimeWires.SeamTrace.Defs
public import Mathlib.Data.Set.Function
import Silmaril.Proofs.Semantics.RuntimeWires.SeamTrace.Closure

public section

namespace Silmaril.RuntimeWires.Sliced

universe u v

variable {O : Type u} {S : Signature.{u,v} O}

/-- A row split lists each old box's destination in original ordinal
order. Tracing the two rows gives the renamed output frontier and a
permutation of the renamed, addressed box records. -/
theorem Row.Split.trace_rows {A M B : List O} {r : Row S A B} {p : Row S A M} {q : Row S M B}
    (split : Row.Split S r p q) (row upper lower : ℕ) :
    ∃ destinations : List BoxAddress, destinations.length = r.boxCount ∧
      ∀ (route : BoxAddress → BoxAddress) (first : ℕ), RoutesBoxes route row first destinations →
      ∀ input : List (NamedWire O), input.length = A.length →
        let original := r.traceWires row first input
        let sliced := traceSplitRows p q row upper lower (input.map (NamedWire.rename route))
        original.frontier.map (NamedWire.rename route) = sliced.1 ∧
          ((addressBoxes row first original.boxes).map (BoxOccurrence.rename route)).Perm sliced.2 :=
  Proofs.SeamTrace.trace_split_rows split row upper lower

theorem SheetTrace.Renamed.bijOn {p q : SheetTrace S} {route : BoxAddress → BoxAddress}
    (renamed : p.Renamed q route) : Set.BijOn route p.boxAddresses q.boxAddresses :=
  Proofs.SeamTrace.route_bijOn renamed

/-- The inverse on the actual box addresses reverses the incidence
comparison of a bare-sheet trace, including its wire references. -/
theorem SheetTrace.Renamed.inverse {A B : List O} {p : Sheet S A B}
    {q : SheetTrace S} {route : BoxAddress → BoxAddress} (renamed : p.traceWires.Renamed q route) :
    q.Renamed p.traceWires (Function.invFunOn route p.traceWires.boxAddresses) :=
  Proofs.SeamTrace.inverse_trace p renamed renamed.bijOn.injOn.leftInvOn_invFunOn

/-- An elementary seam move preserves decoded incidence through its full
sheet context. The routing is bijective on the decoded box occurrences. -/
theorem Sheet.Move.trace_incidence {A B : List O} {p q : Sheet S A B} (move : Sheet.Move S p q) :
    ∃ route, p.traceWires.Renamed q.traceWires route ∧
      Set.BijOn route p.traceWires.boxAddresses q.traceWires.boxAddresses := by
  obtain ⟨route, trace⟩ := Proofs.SeamTrace.trace_move_bare move
  exact ⟨route, trace, trace.bijOn⟩

/-- Decoded labeled incidence with ordered ports and caps is invariant
under the equivalence generated by the combinatorial seam moves. -/
theorem Sheet.SeamEquivalent.trace_incidence {A B : List O} {p q : Sheet S A B}
    (same : Sheet.SeamEquivalent p q) :
    ∃ route, p.traceWires.Renamed q.traceWires route ∧
      Set.BijOn route p.traceWires.boxAddresses q.traceWires.boxAddresses := by
  obtain ⟨route, trace⟩ := Proofs.SeamTrace.trace_seam same
  exact ⟨route, trace, trace.bijOn⟩

end Silmaril.RuntimeWires.Sliced
